<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Thu muc va ten file log luu tru -->
    <property name="LOG_DIR" value="logs" />
    <property name="LOG_FILE" value="app.log" />

    <!-- 1. Console Appender: In log ra giao dien Terminal -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 2. File Appender: Ghi log vao tep vat ly -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_DIR}/${LOG_FILE}</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root Logger: Muc INFO, kich hoat ca CONSOLE lan FILE -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>
</configuration>
